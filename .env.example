APP_NAME=MediPath
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

MEDIPATH_GEOCODING_ENABLED=true
MEDIPATH_GEOCODING_ENDPOINT=https://nominatim.openstreetmap.org/search
MEDIPATH_GEOCODING_USER_AGENT=MediPath-AI-Prototype/1.0
MEDIPATH_INITIAL_AI_SAFETY_SCREEN=false
MEDIPATH_ASSESSMENT_MAX_QUESTIONS=10

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_TIMEZONE=Africa/Accra

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# URL-encode special characters in the password.
DB_URL=postgresql://medipath_app:YOUR_PASSWORD@127.0.0.1:5432/medipath_dev
# Neon uses the pooled URL for normal application traffic and the direct URL
# for migrations, dumps, and other session-level administration.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Local displays a demo verification code in the UI. Replace this with a real
# SMS provider driver before accepting real patient traffic.
MEDIPATH_PHONE_VERIFICATION_DRIVER=local
MEDIPATH_PHONE_VERIFICATION_EXPIRY_MINUTES=10
MEDIPATH_PHONE_VERIFICATION_MAX_ATTEMPTS=5
MEDIPATH_PHONE_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# BMS/mNotify production SMS delivery. Keep the API key private.
BMS_SMS_ENDPOINT=https://api.mnotify.com/api/sms/quick
BMS_API_KEY=
BMS_SENDER_ID=medipath
BMS_CONNECT_TIMEOUT=5
BMS_TIMEOUT=10

# NALO production SMS delivery. Keep the authentication key private.
NALO_SMS_ENDPOINT=https://sms.nalosolutions.com/smsbackend/Resl_Nalo/send-message/
NALO_AUTH_KEY=
NALO_SENDER_ID=NALO
NALO_CONNECT_TIMEOUT=5
NALO_TIMEOUT=10

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@medipath.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Configure these for the deployment region. Leave the number empty until verified.
MEDIPATH_EMERGENCY_CONTACT_LABEL="Ghana National Ambulance Service"
MEDIPATH_EMERGENCY_PHONE=112

# Keep deterministic for local UI work. Switch to gemini after adding a private API key.
MEDIPATH_ASSESSMENT_DRIVER=deterministic
GEMINI_API_KEY=
GEMINI_ASSESSMENT_MODEL=gemini-3.5-flash-lite
GEMINI_CONSULTANT_MODEL=gemini-3.1-flash-lite
GEMINI_CONSULTANT_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
GEMINI_CONNECT_TIMEOUT=5
GEMINI_TIMEOUT=20
GEMINI_RETRY_DELAY_MS=1000
GEMINI_CONSULTANT_TIMEOUT=30
GEMINI_CONSULTANT_INITIAL_TIMEOUT=12
GEMINI_CONSULTANT_STREAM_INITIAL_TIMEOUT=12
GEMINI_CONSULTANT_STREAM_MAX_ATTEMPTS=1
GEMINI_CONSULTANT_MAX_ATTEMPTS=2
GEMINI_CONSULTANT_MAX_OUTPUT_TOKENS=320
GEMINI_CONSULTANT_THINKING_LEVEL=minimal
GEMINI_CIRCUIT_FAILURE_THRESHOLD=3
GEMINI_CIRCUIT_FAILURE_WINDOW_SECONDS=120
GEMINI_CIRCUIT_COOLDOWN_SECONDS=60
