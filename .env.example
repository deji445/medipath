APP_NAME=MediPath
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

MEDIPATH_GEOCODING_ENABLED=true
MEDIPATH_GEOCODING_ENDPOINT=https://nominatim.openstreetmap.org/search
MEDIPATH_GEOCODING_USER_AGENT=MediPath-AI-Prototype/1.0
MEDIPATH_INITIAL_AI_SAFETY_SCREEN=false
MEDIPATH_ASSESSMENT_MAX_QUESTIONS=10

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_TIMEZONE=Africa/Accra

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# URL-encode special characters in the password.
DB_URL=postgresql://medipath_app:YOUR_PASSWORD@127.0.0.1:5432/medipath_dev

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@medipath.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Configure these for the deployment region. Leave the number empty until verified.
MEDIPATH_EMERGENCY_CONTACT_LABEL="Ghana National Ambulance Service"
MEDIPATH_EMERGENCY_PHONE=112

# Keep deterministic for local UI work. Switch to gemini after adding a private API key.
MEDIPATH_ASSESSMENT_DRIVER=deterministic
GEMINI_API_KEY=
GEMINI_ASSESSMENT_MODEL=gemini-3.8-flash
GEMINI_CONNECT_TIMEOUT=5
GEMINI_TIMEOUT=20
GEMINI_RETRY_DELAY_MS=250
